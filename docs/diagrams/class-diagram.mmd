classDiagram
    direction LR

    class User {
        +bigint id
        +string name
        +string email
        +string passwordHash
        +enum role
        +datetime createdAt
        +datetime updatedAt
    }

    class Project {
        +bigint id
        +bigint userId
        +string name
        +string slug
        +string description
        +int incomingTrafficRps
        +boolean isRunning
        +datetime createdAt
        +datetime updatedAt
    }

    class ComponentCategory {
        +bigint id
        +string name
        +int displayOrder
        +datetime createdAt
    }

    class ComponentType {
        +bigint id
        +bigint categoryId
        +string code
        +string label
        +string icon
        +string colorToken
        +int defaultInstances
        +int defaultCapacityRps
        +int defaultBaseLatencyMs
        +int defaultQueueSize
        +int defaultTimeoutMs
        +decimal defaultCostPerInstance
        +boolean isActive
        +datetime createdAt
        +datetime updatedAt
    }

    class ProjectNode {
        +bigint id
        +bigint projectId
        +bigint componentTypeId
        +string clientNodeId
        +string name
        +decimal positionX
        +decimal positionY
        +int instances
        +int capacityRps
        +int baseLatencyMs
        +int queueSize
        +int timeoutMs
        +decimal costPerInstance
        +datetime createdAt
        +datetime updatedAt
    }

    class ProjectEdge {
        +bigint id
        +bigint projectId
        +string clientEdgeId
        +bigint fromNodeId
        +bigint toNodeId
        +boolean isAsync
        +datetime createdAt
    }

    User "1" --> "0..*" Project : owns
    Project "1" --> "0..*" ProjectNode : contains
    Project "1" --> "0..*" ProjectEdge : connects

    ComponentCategory "1" --> "1..*" ComponentType : groups
    ComponentType "1" --> "0..*" ProjectNode : instantiates

    ProjectNode "1" --> "0..*" ProjectEdge : source
    ProjectNode "1" --> "0..*" ProjectEdge : target
