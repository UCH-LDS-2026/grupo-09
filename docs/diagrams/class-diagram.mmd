classDiagram
    direction LR

    class Usuario {
        +bigint id
        +string nombre
        +string email
        +string hash_contrasena
        +enum rol
        +datetime creado_en
        +datetime actualizado_en
    }

    class Proyecto {
        +bigint id
        +bigint usuario_id
        +string nombre
        +string slug
        +string descripcion
        +int trafico_entrante_rps
        +boolean esta_ejecutando
        +datetime creado_en
        +datetime actualizado_en
    }

    class CategoriaComponente {
        +bigint id
        +string nombre
        +int orden_visualizacion
        +datetime creado_en
    }

    class TipoComponente {
        +bigint id
        +bigint categoria_id
        +string codigo
        +string etiqueta
        +string icono
        +string token_color
        +int instancias_predeterminadas
        +int capacidad_predeterminada_rps
        +int latencia_base_predeterminada_ms
        +int tamano_cola_predeterminado
        +int tiempo_espera_predeterminado_ms
        +decimal costo_por_instancia_predeterminado
        +boolean activo
        +datetime creado_en
        +datetime actualizado_en
    }

    class NodoProyecto {
        +bigint id
        +bigint proyecto_id
        +bigint tipo_componente_id
        +string nodo_cliente_id
        +string nombre
        +decimal posicion_x
        +decimal posicion_y
        +int instancias
        +int capacidad_rps
        +int latencia_base_ms
        +int tamano_cola
        +int tiempo_espera_ms
        +decimal costo_por_instancia
        +datetime creado_en
        +datetime actualizado_en
    }

    class ConexionProyecto {
        +bigint id
        +bigint proyecto_id
        +string conexion_cliente_id
        +bigint nodo_origen_id
        +bigint nodo_destino_id
        +boolean es_asincrona
        +datetime creado_en
    }

    Usuario "1" --> "0..*" Proyecto : posee
    Proyecto "1" --> "0..*" NodoProyecto : contiene
    Proyecto "1" --> "0..*" ConexionProyecto : conecta

    CategoriaComponente "1" --> "1..*" TipoComponente : agrupa
    TipoComponente "1" --> "0..*" NodoProyecto : instancia

    NodoProyecto "1" --> "0..*" ConexionProyecto : origen
    NodoProyecto "1" --> "0..*" ConexionProyecto : destino
